<launch>
    <arg name="cgras_data_folder" default="/home/qcr/cgras_data" />
    <arg name="detector" default="true" />
    <arg name="detector_aux_server" default="true" />
    <arg name="coordinator" default="true" />
    <arg name="coordinator_aux_server" default="true" />    
    <include file="$(find cgras_detector)/launch/main.launch">
        <arg name="namespace" default="cgras" doc="The namespace for the project" />
        <arg name="detector" default="$(arg detector)" />
        <arg name="detector_aux_server" default="$(arg detector_aux_server)" />
        <arg name="coordinator" default="$(arg coordinator)" />
        <arg name="coordinator_aux_server" default="$(arg coordinator_aux_server)" />        
        <arg name="cgras_data_folder" default="$(arg cgras_data_folder)" />
    </include>
</launch>
